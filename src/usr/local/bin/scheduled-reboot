#!/bin/bash

set -Eeuo pipefail
IFS=$' \t\n'

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin

readonly CONFIG=/etc/default/scheduled-reboot
readonly TAG=scheduled-reboot
readonly VERSION=0.55
readonly NOLOGIN=/etc/nologin
readonly NOLOGIN_TEXT='System maintenance is in progress. Please try again later.'
readonly LOCK_DIR=/run/lock/scheduled-reboot.lock
readonly LOCK_PID_FILE=$LOCK_DIR/pid
readonly REBOOT_REQUESTED_MARKER=/run/scheduled-reboot.reboot-requested
readonly PACKAGE_LOCK_WAIT_SECONDS=300
readonly PACKAGE_LOCK_POLL_SECONDS=1

readonly EXIT_GENERAL=2
readonly EXIT_CONFIG=3
readonly EXIT_UPGRADE=4
readonly EXIT_REBOOT=5

scheduled_reboots_disabled=false
email_when_disabled=true
upgrade_at_shutdown=false
script_timeout_seconds=900
package_manager_timeout_seconds=1800
max_output_bytes=10485760

mailto=root
alert_mailsubject="ALERT: scheduled-reboot failed on $(hostname -s 2>/dev/null || echo localhost)"

scripts_dir=/etc/scheduled-reboot
logs_dir=/var/log/scheduled-reboot
run_id=$(printf '%s-%s' "$(date -u +%Y%m%dT%H%M%SZ)" "$$")
run_date=$(date +%Y-%m-%d)
temporary_files=()

case ${1:-} in
    '')
        ;;
    --version)
        printf "%s %s\n" "$TAG" "$VERSION"
        exit 0
        ;;
    *)
        printf 'Usage: %s [--version]\n' "$0" >&2
        exit 64
        ;;
esac

log() {
    logger -t "$TAG" -- "$*" || :
}


mail_alert() {
    local -a recipients
    local failure_marker=${logs_dir:-/var/log/scheduled-reboot}/.mail-alert-failed

    read -r -a recipients <<< "${mailto:-}"

    if ((${#recipients[@]} == 0)); then
        log "run_id=$run_id level=warning event=mail_skipped reason=no_recipients"
        return 0
    fi

    if ! command -v mail >/dev/null 2>&1; then
        log "run_id=$run_id level=error event=mail_failed reason=mail_command_missing"
        # Best-effort: syslog can go unnoticed, so also leave a standing
        # sentinel file that external monitoring can check for, since a
        # failed alert is otherwise silent to anyone but this log.
        printf 'run_id=%s reason=mail_command_missing\n' "$run_id" \
            >"$failure_marker" 2>/dev/null || :
        return 1
    fi

    # Keep notifications readable in terminals and text-only mail clients.
    if ! printf '%s\n' "$1" | fold -w 100 | mail -s "$2" "${recipients[@]}"; then
        log "run_id=$run_id level=error event=mail_failed"
        printf 'run_id=%s reason=mail_command_failed\n' "$run_id" \
            >"$failure_marker" 2>/dev/null || :
        return 1
    fi

    rm -f -- "$failure_marker" 2>/dev/null || :
}


mail_alert_with_logs() {
    local message=$1
    local subject=$2
    shift 2
    local file
    local section
    local max_lines
    local -a error_files=()
    local -a output_files=()
    local -a other_files=()
    local body
    body=$(printf "%s %s\n\n%s\n" "$TAG" "$VERSION" "$message")

    for file in "$@"; do
        case $file in
            *.err) error_files+=("$file") ;;
            *.out) output_files+=("$file") ;;
            *) other_files+=("$file") ;;
        esac
    done

    for file in "${error_files[@]}" "${other_files[@]}" "${output_files[@]}"; do
        [[ -s $file ]] || continue
        max_lines=0
        [[ $file == *.out ]] && max_lines=20
        if ! section=$(format_log_file "$file" "$max_lines" "$run_date"); then
            log "run_id=$run_id level=error event=log_read_failed file=$file"
            return 1
        fi
        body+=$'\n'
        body+=$(printf '===== %s =====' "$file")
        body+=$'\n'
        body+="$section"
        body+=$'\n'
    done
    mail_alert "$body" "$subject"
}


format_log_file() {
    local file=$1
    local max_lines=$2
    local date_prefix=$3
    local line
    local -a output_lines=()

    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line == "[$date_prefix"* ]] || continue
        if ((max_lines > 0)); then
            output_lines+=("$line")
            if ((${#output_lines[@]} > max_lines)); then
                output_lines=("${output_lines[@]:1}")
            fi
        else
            printf '%s\n' "$line"
        fi
    done <"$file"

    if ((max_lines > 0 && ${#output_lines[@]} > 0)); then
        printf '%s\n' "${output_lines[@]}"
    fi
}


timestamp_file() {
    local input=$1
    local output=$2
    local line

    while IFS= read -r line || [[ -n $line ]]; do
        printf '[%(%Y-%m-%dT%H:%M:%S%z)T] %s\n' -1 "$line"
    done <"$input" >>"$output"
}


cap_output_file() {
    local file=$1
    local size

    size=$(stat -c '%s' -- "$file" 2>/dev/null) || return 0
    ((size > max_output_bytes)) || return 0

    {
        head -c "$max_output_bytes" -- "$file"
        printf '\n[scheduled-reboot: output truncated at %d of %d bytes]\n' \
            "$max_output_bytes" "$size"
    } >"$file.capped" 2>/dev/null &&
        mv -- "$file.capped" "$file"
}


run_logged() {
    local stdout_log=$1
    local stderr_log=$2
    local timeout_seconds=$3
    local label=$4
    shift 4

    local stdout_tmp
    local stderr_tmp
    local rc
    local child_pid
    local started=$SECONDS

    stdout_tmp=$(mktemp "$logs_dir/.stdout.XXXXXX") ||
        return 125
    temporary_files+=("$stdout_tmp")
    stderr_tmp=$(mktemp "$logs_dir/.stderr.XXXXXX") || {
        rm -f -- "$stdout_tmp"
        return 125
    }
    temporary_files+=("$stderr_tmp")

    log "run_id=$run_id phase=$label event=start command=$* timeout_seconds=$timeout_seconds"

    # setsid makes the command (and its ordinary, non-detaching children)
    # leader of a new process group equal to its own PID, so that on
    # timeout we can sweep the whole group below -- `timeout` by itself
    # only ever signals its direct child, so anything the command
    # backgrounds on its own would otherwise outlive the timeout. This
    # cannot catch a child that calls setsid() itself to fully detach into
    # its own session.
    setsid timeout --foreground --kill-after=30s "$timeout_seconds" "$@" \
        >"$stdout_tmp" 2>"$stderr_tmp" &
    child_pid=$!

    if wait "$child_pid"; then
        rc=0
    else
        rc=$?
    fi

    if kill -0 -- "-$child_pid" 2>/dev/null; then
        log "run_id=$run_id level=warning event=residual_processes phase=$label pgid=$child_pid"
        kill -TERM -- "-$child_pid" 2>/dev/null || :
        sleep 5
        kill -KILL -- "-$child_pid" 2>/dev/null || :
    fi

    cap_output_file "$stdout_tmp"
    cap_output_file "$stderr_tmp"

    if ! timestamp_file "$stdout_tmp" "$stdout_log" ||
        ! timestamp_file "$stderr_tmp" "$stderr_log"; then
        rc=125
    fi
    rm -f -- "$stdout_tmp" "$stderr_tmp"
    log "run_id=$run_id phase=$label event=finish status=$rc elapsed_seconds=$((SECONDS - started))"

    return "$rc"
}

die() {
    local exit_code=$1
    local message=$2
    shift 2
    log "run_id=$run_id level=error event=failure message=$message exit_code=$exit_code"
    mail_alert_with_logs "$message" "$alert_mailsubject" "$@" || :
    exit "$exit_code"
}


path_is_secure() {
    local path=$1
    local current=$path
    local owner mode

    while true; do
        read -r owner mode < <(stat -c '%u %a' -- "$current" 2>/dev/null) || return 2

        ((owner == 0)) || return 1
        (( (8#$mode & 8#022) == 0 )) || return 1

        [[ $current == / ]] && return 0
        current=$(dirname -- "$current")
    done
}


require_secure_path() {
    local path=$1
    local label=$2
    local rc=0

    path_is_secure "$path" || rc=$?

    case $rc in
        0) return 0 ;;
        1) die "$EXIT_CONFIG" "Refusing to trust $label: not root-owned or writable by group/other somewhere in its path: $path" ;;
        *) die "$EXIT_CONFIG" "Cannot verify ownership/permissions of $label: $path" ;;
    esac
}


remove_nologin() {
    [[ -f $NOLOGIN && ! -L $NOLOGIN ]] || return 0

    if [[ $(cat -- "$NOLOGIN" 2>/dev/null || :) == "$NOLOGIN_TEXT" ]]; then
        rm -f -- "$NOLOGIN" || :
    fi
}


cleanup() {
    if ((reboot_requested == 0)); then
        remove_nologin
    fi

    rm -f -- "$LOCK_PID_FILE" 2>/dev/null || :
    rmdir -- "$LOCK_DIR" 2>/dev/null || :

    local temporary_file
    for temporary_file in "${temporary_files[@]}"; do
        rm -f -- "$temporary_file" || :
    done
}


acquire_lock() {
    if mkdir -- "$LOCK_DIR" 2>/dev/null; then
        printf '%s\n' "$$" >"$LOCK_PID_FILE" 2>/dev/null || :
        return 0
    fi

    local lock_pid
    lock_pid=$(cat -- "$LOCK_PID_FILE" 2>/dev/null || :)

    if [[ $lock_pid =~ ^[0-9]+$ ]] && kill -0 "$lock_pid" 2>/dev/null; then
        log "Another scheduled-reboot process (pid $lock_pid) is running; skipping"
        return 1
    fi

    log "run_id=$run_id level=warning event=stale_lock_removed lock_dir=$LOCK_DIR previous_pid=${lock_pid:-unknown}"
    rm -rf -- "$LOCK_DIR" 2>/dev/null || :

    if ! mkdir -- "$LOCK_DIR" 2>/dev/null; then
        log 'Another scheduled-reboot process is running; skipping'
        return 1
    fi
    printf '%s\n' "$$" >"$LOCK_PID_FILE" 2>/dev/null || :
    return 0
}


check_lock() {
    local lock_file=$1
    local rc
    local waited=0

    [[ -e $lock_file ]] || return 0

    if ! command -v fuser >/dev/null 2>&1; then
        die "$EXIT_CONFIG" 'fuser is required for package-lock checks'
    fi

    if fuser "$lock_file" >/dev/null 2>&1; then
        rc=0
    else
        rc=$?
    fi

    case $rc in
        0)
            log "Package operation in progress: $lock_file; waiting up to ${PACKAGE_LOCK_WAIT_SECONDS}s"

            while ((waited < PACKAGE_LOCK_WAIT_SECONDS)); do
                sleep "$PACKAGE_LOCK_POLL_SECONDS" ||
                    die "$EXIT_GENERAL" "Interrupted while waiting for package lock: $lock_file"
                waited=$((waited + PACKAGE_LOCK_POLL_SECONDS))

                if fuser "$lock_file" >/dev/null 2>&1; then
                    continue
                else
                    rc=$?
                fi

                case $rc in
                    1)
                        log "Package operation completed: $lock_file"
                        return 0
                        ;;
                    *)
                        die "$EXIT_GENERAL" "Cannot inspect package lock: $lock_file"
                        ;;
                esac
            done

            die "$EXIT_GENERAL" "Package operation still in progress after ${PACKAGE_LOCK_WAIT_SECONDS}s: $lock_file"
            ;;
        1)
            return 0
            ;;
        *)
            die "$EXIT_GENERAL" "Cannot inspect package lock: $lock_file"
            ;;
    esac
}


scripts() {
    local directory=$1

    if [[ -d $directory ]]; then
        find "$directory" \
            -mindepth 1 \
            -maxdepth 1 \
            -type f \
            -perm /111 \
            -print0 |
            sort -z
    fi
}


run_scripts() {
    local directory=$1
    local stdout_log=$2
    local stderr_log=$3
    local phase=$4

    local script
    local script_list
    local rc
    local failed=0

    script_list=$(mktemp "$logs_dir/.scripts.XXXXXX") || return 1
    temporary_files+=("$script_list")

    if ! scripts "$directory" >"$script_list"; then
        log "run_id=$run_id level=error event=script_discovery_failed phase=$phase directory=$directory"
        rm -f -- "$script_list"
        return 1
    fi

    while IFS= read -r -d '' script; do
        if [[ ! -r $script ]]; then
            log "run_id=$run_id level=error event=script_read_failed phase=$phase script=$script"
            failed=1
            continue
        fi

        if ! path_is_secure "$script"; then
            log "run_id=$run_id level=error event=script_insecure phase=$phase script=$script"
            failed=1
            continue
        fi

        local first_line
        if ! first_line=$(head -n 1 -- "$script"); then
            log "run_id=$run_id level=error event=script_read_failed phase=$phase script=$script"
            failed=1
            continue
        fi

        if [[ $first_line != '#!'* ]]; then
            log "Skipping executable without shebang: $script"
            continue
        fi

        log "Executing $phase script: $script"

        if run_logged "$stdout_log" "$stderr_log" "$script_timeout_seconds" "$phase:$script" "$script"; then
            log "Script completed successfully: $script"
        else
            rc=$?
            log "ERROR: $phase script failed (exit $rc): $script"
            failed=1
        fi
    done <"$script_list"

    rm -f -- "$script_list"

    return "$failed"
}


if [[ -r $CONFIG ]]; then
    require_secure_path "$CONFIG" 'config file'
    source "$CONFIG"
fi

for variable in \
    scheduled_reboots_disabled \
    email_when_disabled \
    upgrade_at_shutdown
do
    if [[ ${!variable} != true && ${!variable} != false ]]; then
        die "$EXIT_CONFIG" "Invalid boolean: $variable"
    fi
done

for variable in script_timeout_seconds package_manager_timeout_seconds max_output_bytes; do
    if [[ ! ${!variable} =~ ^[1-9][0-9]*$ ]]; then
        die "$EXIT_CONFIG" "Invalid timeout: $variable"
    fi
done

if ! command -v timeout >/dev/null 2>&1; then
    die "$EXIT_CONFIG" 'timeout is required'
fi

if ! command -v setsid >/dev/null 2>&1; then
    die "$EXIT_CONFIG" 'setsid is required'
fi

if [[ $scripts_dir != /* || $logs_dir != /* ]]; then
    die "$EXIT_CONFIG" 'Configured paths must be absolute'
fi

install -d -m 0755 -- "$logs_dir" ||
    die "$EXIT_GENERAL" "Cannot create $logs_dir"

log_files=(
    pre-reboot-scripts.out
    pre-reboot-scripts.err
    on-pre-reboot-failure-scripts.out
    on-pre-reboot-failure-scripts.err
    pre-reboot-upgrades.out
    pre-reboot-upgrades.err
)

for log_file in "${log_files[@]}"; do
    touch "$logs_dir/$log_file" ||
        die "$EXIT_GENERAL" "Cannot create log $log_file"
done

if [[ -e $REBOOT_REQUESTED_MARKER ]]; then
    log "run_id=$run_id level=warning event=reboot_not_observed marker=$REBOOT_REQUESTED_MARKER"
    mail_alert_with_logs \
        'A previous scheduled-reboot run requested a reboot via systemctl, but the system has not rebooted since (it may have been inhibited, delayed, or failed asynchronously). /etc/nologin may still be blocking logins from that run; investigate.' \
        "$alert_mailsubject" ||
        :
fi

if [[ $scheduled_reboots_disabled == true ]]; then
    log 'Scheduled reboots are disabled; skipping'

    if [[ $email_when_disabled == true ]]; then
        mail_alert_with_logs \
            'Scheduled reboot was skipped because scheduled reboots are disabled.' \
            "$alert_mailsubject" ||
            :
    fi

    exit 0
fi

if ! acquire_lock; then
    exit 0
fi

reboot_requested=0
trap cleanup EXIT

if command -v dpkg >/dev/null 2>&1; then
    check_lock /var/lib/dpkg/lock
    check_lock /var/lib/dpkg/lock-frontend
elif command -v rpm >/dev/null 2>&1; then
    check_lock /var/lib/rpm/.rpm.lock
    check_lock /var/lib/rpm/.dbenv.lock
fi

if [[ -e $NOLOGIN || -L $NOLOGIN ]]; then
    log "$NOLOGIN exists; leaving it untouched"
else
    temporary_nologin=$(
        mktemp /etc/.nologin.scheduled-reboot.XXXXXX
    ) || die "$EXIT_GENERAL" 'Cannot create /etc/nologin'

    if ! printf '%s\n' "$NOLOGIN_TEXT" >"$temporary_nologin"; then
        rm -f -- "$temporary_nologin" || :
        die "$EXIT_GENERAL" 'Cannot write /etc/nologin'
    fi

    if ! chmod 0644 "$temporary_nologin"; then
        rm -f -- "$temporary_nologin" || :
        die "$EXIT_GENERAL" 'Cannot set permissions on /etc/nologin'
    fi

    if ! mv -- "$temporary_nologin" "$NOLOGIN"; then
        rm -f -- "$temporary_nologin"
        die "$EXIT_GENERAL" 'Cannot install /etc/nologin'
    fi
fi

if ! run_scripts \
    "$scripts_dir/pre-reboot" \
    "$logs_dir/pre-reboot-scripts.out" \
    "$logs_dir/pre-reboot-scripts.err" \
    pre-reboot
then
    mail_alert_with_logs \
        'A pre-reboot script failed; reboot cancelled.' \
        "$alert_mailsubject" \
        "$logs_dir/pre-reboot-scripts.out" \
        "$logs_dir/pre-reboot-scripts.err" ||
        :

    run_scripts \
        "$scripts_dir/on-pre-reboot-failure" \
        "$logs_dir/on-pre-reboot-failure-scripts.out" \
        "$logs_dir/on-pre-reboot-failure-scripts.err" \
        failure ||
        :

    remove_nologin
    exit "$EXIT_GENERAL"
fi

if [[ $upgrade_at_shutdown == true ]]; then
    upgrade_stdout="$logs_dir/pre-reboot-upgrades.out"
    upgrade_stderr="$logs_dir/pre-reboot-upgrades.err"

    if command -v apt-get >/dev/null 2>&1; then
        export DEBIAN_FRONTEND=noninteractive

        run_logged "$upgrade_stdout" "$upgrade_stderr" "$package_manager_timeout_seconds" apt-update apt-get -qq update ||
            die "$EXIT_UPGRADE" 'APT update failed; reboot cancelled' "$upgrade_stdout" "$upgrade_stderr"

        run_logged "$upgrade_stdout" "$upgrade_stderr" "$package_manager_timeout_seconds" apt-upgrade apt-get -qq -y upgrade ||
            die "$EXIT_UPGRADE" 'APT upgrade failed; reboot cancelled' "$upgrade_stdout" "$upgrade_stderr"

    elif command -v dnf >/dev/null 2>&1; then
        run_logged "$upgrade_stdout" "$upgrade_stderr" "$package_manager_timeout_seconds" dnf-makecache dnf -y makecache ||
            die "$EXIT_UPGRADE" 'DNF cache update failed; reboot cancelled' "$upgrade_stdout" "$upgrade_stderr"

        run_logged "$upgrade_stdout" "$upgrade_stderr" "$package_manager_timeout_seconds" dnf-upgrade dnf -y upgrade ||
            die "$EXIT_UPGRADE" 'DNF upgrade failed; reboot cancelled' "$upgrade_stdout" "$upgrade_stderr"

    elif command -v yum >/dev/null 2>&1; then
        run_logged "$upgrade_stdout" "$upgrade_stderr" "$package_manager_timeout_seconds" yum-makecache yum -y makecache ||
            die "$EXIT_UPGRADE" 'YUM cache update failed; reboot cancelled' "$upgrade_stdout" "$upgrade_stderr"

        run_logged "$upgrade_stdout" "$upgrade_stderr" "$package_manager_timeout_seconds" yum-update yum -y update ||
            die "$EXIT_UPGRADE" 'YUM update failed; reboot cancelled' "$upgrade_stdout" "$upgrade_stderr"

    else
        die "$EXIT_CONFIG" 'No supported package manager found'
    fi
fi

log 'All pre-reboot tasks complete; requesting reboot'

# Written to a tmpfs path that only survives until the next real reboot: if
# it's still there next run, systemctl reboot returned success below but the
# system never actually went down (see the reboot_not_observed check above).
printf '%s\n' "$run_id" >"$REBOOT_REQUESTED_MARKER" 2>/dev/null || :

if systemctl reboot; then
    reboot_requested=1
    trap - EXIT
else
    rm -f -- "$REBOOT_REQUESTED_MARKER" 2>/dev/null || :
    die "$EXIT_REBOOT" 'systemctl reboot failed'
fi
