#!/bin/bash

set -Eeuo pipefail
IFS=$' \t\n'

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin

readonly CONFIG=/etc/default/scheduled-reboot
readonly NOLOGIN=/etc/nologin
readonly NOLOGIN_TEXT='System maintenance is in progress. Please try again later.'

scripts_dir=/etc/scheduled-reboot
logs_dir=/var/log/scheduled-reboot

mailto=root
alert_mailsubject="ALERT: scheduled-reboot failed on $(hostname -s 2>/dev/null || echo localhost)"

if [[ -r $CONFIG ]]; then
    source "$CONFIG"
fi


log() {
    logger -t scheduled-reboot -- "$*" || :
}


mail_alert() {
    local -a recipients

    read -r -a recipients <<< "${mailto:-}"

    if ((${#recipients[@]})) && command -v mail >/dev/null 2>&1; then
        printf '%s\n' "$1" |
            mail -s "$2" "${recipients[@]}"
    fi
}


if [[
    -f $NOLOGIN &&
    ! -L $NOLOGIN &&
    $(cat -- "$NOLOGIN" 2>/dev/null || :) == "$NOLOGIN_TEXT"
]]; then
    rm -f -- "$NOLOGIN" || :
fi

install -d -m 0755 -- "$logs_dir"

log_files=(
    post-reboot-scripts.out
    post-reboot-scripts.err
)

for log_file in "${log_files[@]}"; do
    touch "$logs_dir/$log_file"
done

post_reboot_stdout="$logs_dir/post-reboot-scripts.out"
post_reboot_stderr="$logs_dir/post-reboot-scripts.err"

failed=0

while IFS= read -r -d '' script; do
    if [[ $(head -n 1 -- "$script" 2>/dev/null || :) != '#!'* ]]; then
        log "Skipping executable without shebang: $script"
        continue
    fi

    log "Executing post-reboot script: $script"

    if ! "$script" >>"$post_reboot_stdout" 2>>"$post_reboot_stderr"; then
        log "ERROR: post-reboot script failed: $script"
        failed=1
    fi
done < <(
    if [[ -d $scripts_dir/post-reboot ]]; then
        find "$scripts_dir/post-reboot" \
            -mindepth 1 \
            -maxdepth 1 \
            -type f \
            -perm /111 \
            -print0 |
            sort -z
    fi
)

if ((failed)); then
    mail_alert \
        'One or more post-reboot scripts failed.' \
        "$alert_mailsubject"

    exit 2
fi

log 'Post-reboot tasks completed successfully'
